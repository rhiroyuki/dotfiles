{
  "modules-left": [
    "sway/workspaces",
    "custom/sep",
    "sway/window"
  ],
  "modules-right": [
    "custom/sep",
    "custom/gpu",
    "custom/sep",
    "custom/cpu",
    "custom/sep",
    "custom/mem",
    "custom/sep",
    "disk",
    "custom/sep",
    "tray",
    "custom/sep",
    "pulseaudio",
    "custom/sep",
    "custom/net",
    "custom/sep",
    "network",
    "custom/sep",
    "custom/bluetooth",
    "custom/sep",
    "clock"
  ],

  "clock": {
    "format-alt": "{:%Y-%m-%d}"
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/custom/gpu.sh",
    "interval": 3,
    "format": "{}"
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/custom/cpu.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": false
  },
  "custom/mem": {
    "exec": "~/.config/waybar/custom/mem.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },
  "disk": {
    "interval": 60,
    "path": "/",
    "format": "Disk: {free}"
  },
  "custom/bluetooth": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/custom/bluetooth.sh",
    "on-click": "foot bluetui",
    "on-click-right": "blueman-manager",
    "interval": 30,
    "tooltip": true
  },
  "custom/net": {
    "exec": "~/.config/waybar/custom/net.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": false
  },
  "network": {
    "interval": 5,
    "interface": "wlan0",
    "format": "{ifname}",
    "format-wifi": " ",
    "format-ethernet": "{ipaddr}/{cidr} 󰊗",
    "format-disconnected": "",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "foot impala",
    "max-length": 50
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
        "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
        "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
        "headphone": " ",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "phone-muted": " ",
        "portable": "",
        "car": " ",
        "default": [" ", " "]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "Bat: {capacity}% {icon} {time}",
    "format-plugged": "{capacity}% ",
    "format-alt": "Bat {capacity}%",
    "format-time": "{H}:{M}",
    "format-icons": ["", "", "", "", ""]
  },
  "sway/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true
  },
  "sway/window": {
    "format": "{title}"
  },
  "tray": {
    "icon-size": 20,
    "spacing": 8
  },
  "custom/sep": {
    "format": "|",
    "interval": 0
  },
  "sway/language": {
    "format": "{}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
  }
}
