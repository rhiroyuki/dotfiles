{
  "modules-left": [
    "hyprland/workspaces",
    "custom/sep",
    "hyprland/window"
  ],
  "modules-right": [
    "custom/sep",
    "custom/gpu",
    "custom/sep",
    "custom/cpu",
    "custom/sep",
    "custom/mem",
    "custom/sep",
    "custom/disk",
    "custom/sep",
    "custom/temp",
    "custom/sep",
    "tray",
    "custom/sep",
    "custom/brightness",
    "custom/sep",
    "pulseaudio",
    "custom/sep",
    "custom/net",
    "custom/sep",
    "network",
    "custom/sep",
    "custom/bluetooth",
    "custom/sep",
    "clock",
    "custom/sep",
    "custom/keybindings",
    "custom/sep",
    "custom/power"
  ],

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    }
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/custom/startup-gate.sh gpu.sh",
    "return-type": "json",
    "interval": 3,
    "format": "{}",
    "tooltip": true
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/custom/startup-gate.sh cpu.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": true
  },
  "custom/mem": {
    "exec": "~/.config/waybar/custom/startup-gate.sh mem.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": true
  },
  "custom/disk": {
    "exec": "~/.config/waybar/custom/startup-gate.sh disk.sh",
    "return-type": "json",
    "interval": 30,
    "format": "{}",
    "tooltip": true
  },
  "custom/temp": {
    "exec": "~/.config/waybar/custom/startup-gate.sh temp.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "on-click": "foot watch -n 1 sensors"
  },
  "custom/bluetooth": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/custom/startup-gate.sh bluetooth.sh",
    "on-click": "foot bluetui",
    "on-click-right": "blueman-manager",
    "interval": 30,
    "tooltip": true
  },
  "custom/net": {
    "exec": "~/.config/waybar/custom/startup-gate.sh net.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": false
  },
  "network": {
    "interval": 5,
    "interface": "wlan0",
    "format": "{ifname}",
    "format-wifi": " ",
    "format-ethernet": "{ipaddr}/{cidr} 󰊗",
    "format-disconnected": "",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "foot impala",
    "max-length": 50
  },
  "custom/brightness": {
    "exec": "~/.config/waybar/custom/brightness.sh",
    "interval": 2,
    "on-scroll-up": "~/.config/waybar/custom/brightness.sh up",
    "on-scroll-down": "~/.config/waybar/custom/brightness.sh down"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "󰝟",
    "format-icons": {
        "headphone": "󰋋",
        "hands-free": "󰋎",
        "headset": "󰋎",
        "phone": "󰏲",
        "portable": "󰏲",
        "car": "󰄋",
        "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "Bat: {capacity}% {icon} {time}",
    "format-plugged": "{capacity}% ",
    "format-alt": "Bat {capacity}%",
    "format-time": "{H}:{M}",
    "format-icons": ["", "", "", "", ""]
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },
  "hyprland/window": {
    "format": "{title}"
  },
  "tray": {
    "icon-size": 20,
    "spacing": 8
  },
  "custom/sep": {
    "format": "|",
    "interval": 0
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/dotfiles/bin/session-powermenu"
  },
  "custom/keybindings": {
    "format": "?",
    "tooltip-format": "Show Hyprland keybindings (ALT+SHIFT+/)",
    "on-click": "~/.config/hypr/bin/keybindings"
  },
  "sway/language": {
    "format": "{}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
  }
}
