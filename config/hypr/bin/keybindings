#!/usr/bin/env bash
# vim: set ft=sh:
# Display all hyprland keybindings in rofi; selecting one activates it.

CONFIG="$HOME/.config/hypr/hyprland.conf"

# Each entry is TAB-separated: <display>\t<dispatcher and args>
# The display column is shown in rofi; the dispatch column drives hyprctl.
entries="$(awk '
  /^submap = / {
    if ($3 == "reset") {
      current_submap = ""
    } else {
      current_submap = $3
    }
    next
  }

  /^bind[elm]? = / {
    line = $0
    sub(/^bind[elm]? = /, "", line)

    # Split by comma: mods, key, dispatcher, params...
    n = split(line, parts, /[[:space:]]*,[[:space:]]*/)
    mods = parts[1]
    key  = parts[2]
    disp = parts[3]

    # Reconstruct dispatcher arguments from any remaining params
    args = ""
    for (i = 4; i <= n; i++) args = args (i > 4 ? " " : "") parts[i]
    dispatch = disp (args != "" ? " " args : "")

    # Build key combo display
    combo = (mods != "") ? mods "+" key : key
    gsub(/[[:space:]]/, "", combo)

    # Use preceding comment as description
    desc = (prev_comment != "") ? prev_comment : dispatch
    if (length(desc) > 60) desc = substr(desc, 1, 57) "..."

    prefix = (current_submap != "") ? "[" current_submap "] " : ""
    printf "%-35s  %s%s\t%s\n", combo, prefix, desc, dispatch
    prev_comment = ""
    next
  }

  /^[[:space:]]*#/ {
    line = $0
    sub(/^[[:space:]]*# ?/, "", line)
    prev_comment = line
    next
  }

  { prev_comment = "" }
' "$CONFIG" | sort)"

# Show only the display column; rofi returns the selected index.
idx="$(cut -f1 <<< "$entries" | rofi -dmenu -i -p "Keybindings" -no-custom -format i)"
[ -z "$idx" ] && exit 0

# Look up the dispatch command for the chosen index and activate it.
dispatch="$(sed -n "$((idx + 1))p" <<< "$entries" | cut -f2)"
[ -z "$dispatch" ] && exit 0

hyprctl dispatch $dispatch
