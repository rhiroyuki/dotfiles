#!/usr/bin/env bash
# vim: set ft=sh:
# Toggle a persistent float window rule for the focused window's class.
# No rule yet -> confirm and add one; rule exists -> confirm and remove it.
# Reloads Hyprland and updates the current window immediately.
# Bound in hyprland.lua: ALT SHIFT + F.
#
# Targets hyprland.lua: since Hyprland 0.55 hyprlang is deprecated, and the
# old hyprland.conf has been deleted.

config="$HOME/.config/hypr/hyprland.lua"

# Grab class + address from the focused window in a single query, before the
# yad dialog opens and steals focus (a later query would target yad itself).
window=$(hyprctl activewindow -j)
class=$(jq -r '.class // ""' <<<"$window")
address=$(jq -r '.address // ""' <<<"$window")

if [ -z "$class" ]; then
  notify-send -t 2000 "Float window" "No focused window to float."
  exit 1
fi

rule="hl.window_rule({ match = { class = \"$class\" }, float = true })"

# Fixed-string match: class names contain dots that would be regex wildcards.
if grep -qF "$rule" "$config"; then
  # Rule exists -> confirm removal and re-tile this class.
  text=$(printf 'Stop floating windows of:\n\n<b>%s</b>' "$class")
  yad --question --center --title="Float window" --text="$text" \
      --button="Cancel:1" --button="Stop floating:0" || exit 0

  # Rewrite through the symlink (cat >, not mv/sed -i) so the repo file
  # stays linked. The guard avoids truncating the config if grep fails.
  tmp=$(mktemp)
  grep -vF "$rule" "$config" >"$tmp"
  [ -s "$tmp" ] && cat "$tmp" >"$config"
  rm -f "$tmp"

  hyprctl reload >/dev/null
  hyprctl dispatch "hl.dsp.window.float({ action = \"off\", window = \"address:$address\" })" >/dev/null
  notify-send -t 2000 "Float window" "\"$class\" will no longer float."
  exit 0
fi

# No rule yet -> confirm and add one.
text=$(printf 'Always float windows of:\n\n<b>%s</b>' "$class")
yad --question --center --title="Float window" --text="$text" \
    --button="Cancel:1" --button="Float:0" || exit 0

printf '%s\n' "$rule" >>"$config"
hyprctl reload >/dev/null
hyprctl dispatch "hl.dsp.window.float({ action = \"on\", window = \"address:$address\" })" >/dev/null
notify-send -t 2000 "Float window" "\"$class\" will now float."
