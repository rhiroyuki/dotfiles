#!/bin/sh

chosen=$(printf "🔒 Lock\n💤 Suspend\n🔄 Reboot\n⏻ Shutdown\n🚪 Log Out" | rofi -p "Session:" -dmenu -i)

lock() {
  i3lock --nofork -i "$HOME/dotfiles/wallpapers/cloudy.png"
}

case "$chosen" in
  "🔒 Lock")      lock ;;
  "💤 Suspend")   lock & systemctl suspend ;;
  "🔄 Reboot")    systemctl reboot ;;
  "⏻ Shutdown")  systemctl poweroff ;;
  "🚪 Log Out")   i3-msg exit ;;
  *) exit 1 ;;
esac
