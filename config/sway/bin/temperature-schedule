#!/usr/bin/env bash
# Day/night color-temperature schedule for Sway.
#
# wl-gammarelay-rs only holds a fixed temperature; it does not transition on
# a schedule the way wlsunset (or Hyprland's hyprsunset profiles) does. This
# script applies the current hour's temperature from bin/lib/temperature-
# profile.sh -- the single source of the schedule, shared with Hyprland's
# generated hyprsunset.conf (issue 0013) -- via `bin/gamma temp`, the single
# owner of colour temperature. Run
# with --daemon from the Sway config to keep it updated; run with no args to
# apply once.

# Installed config helpers are symlinks under ~/.config. Resolve the link before
# walking back to the repository, otherwise an invocation through
# ~/.config/sway/bin points at ~/.config/bin instead of this checkout.
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
# shellcheck source=/dev/null
source "$REPO_ROOT/bin/lib/temperature-profile.sh"

apply_current_temp() {
    "$REPO_ROOT/bin/gamma" temp "$(profile_temp_for_hour "$(profile_current_hour)")"
}

case "$1" in
    --daemon)
        last_temp=""
        while true; do
            current_temp="$(profile_temp_for_hour "$(profile_current_hour)")"
            if [[ "$current_temp" != "$last_temp" ]]; then
                # A missing backend is intentionally a successful no-op for
                # interactive gamma callers, but the daemon must not mark the
                # hour as applied in that case. Strict mode makes it retry
                # after the compositor/backend becomes available; a transient
                # write failure is also retried on the next cadence.
                if GAMMA_REQUIRE_BACKEND=1 "$REPO_ROOT/bin/gamma" temp "$current_temp"; then
                    last_temp="$current_temp"
                fi
            fi
            # A one-minute bound keeps a profile transition prompt without
            # waking the shell and D-Bus backend every few seconds.
            sleep 60
        done
        ;;
    *)
        apply_current_temp
        ;;
esac
